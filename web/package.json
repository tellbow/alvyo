{
	"name": "alvyo-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "bun run test:unit --run && bun run test:e2e",
		"test:e2e": "playwright install chromium && playwright test",
		"gen:api": "cd .. && go run ./api/cmd/alvyo openapi > web/src/lib/api/openapi.json && cd web && openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/figtree": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"html-to-image": "1.11.13",
		"maplibre-gl": "6.10.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^14.0.0"
	}
}
