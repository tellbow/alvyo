<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: as backup_rules.xml, for the cloud and for moving
     to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="packs/" />
        <exclude domain="file" path="peaks/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="packs/" />
        <exclude domain="file" path="peaks/" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
