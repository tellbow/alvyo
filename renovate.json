{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended",
		"helpers:pinGitHubActionDigests",
		"docker:pinDigests"
	],
	"timezone": "Europe/Zurich",
	"schedule": [
		"before 6am on monday"
	],
	"minimumReleaseAge": "7 days",
	"postUpdateOptions": [
		"gomodTidy"
	],
	"packageRules": [
		{
			"description": "Our own module, taken from ../swiss by the replace in api/go.mod",
			"matchPackageNames": [
				"github.com/tellbow/alvyo/swiss"
			],
			"enabled": false
		},
		{
			"description": "Node's types follow the Node the website runs on (web/Dockerfile)",
			"matchPackageNames": [
				"@types/node"
			],
			"allowedVersions": "<25"
		},
		{
			"description": "TypeScript 7 once svelte-check and typescript-eslint take it (2026-10-10: up to 6)",
			"matchPackageNames": [
				"typescript"
			],
			"allowedVersions": "<7"
		},
		{
			"description": "Android's Gradle, AGP and Kotlin: by hand with Flutter, which supports only certain versions",
			"matchFileNames": [
				"app/android/**"
			],
			"enabled": false
		},
		{
			"matchManagers": [
				"gomod"
			],
			"groupName": "go modules"
		},
		{
			"matchManagers": [
				"bun",
				"npm"
			],
			"groupName": "web dependencies"
		},
		{
			"matchManagers": [
				"pub"
			],
			"groupName": "app dependencies"
		},
		{
			"matchManagers": [
				"github-actions"
			],
			"groupName": "github actions"
		},
		{
			"matchDepNames": [
				"flutter"
			],
			"groupName": "app dependencies"
		},
		{
			"matchManagers": [
				"dockerfile",
				"docker-compose"
			],
			"groupName": "images"
		},
		{
			"description": "Small updates merge themselves once CI is green",
			"matchUpdateTypes": [
				"patch",
				"digest",
				"pinDigest"
			],
			"automerge": true
		}
	],
	"customManagers": [
		{
			"description": "The Flutter SDK of CI and releases (subosito/flutter-action's flutter-version)",
			"customType": "regex",
			"managerFilePatterns": [
				"/^\\.github/workflows/(ci|release)\\.yml$/"
			],
			"matchStrings": [
				"flutter-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
			],
			"depNameTemplate": "flutter",
			"datasourceTemplate": "flutter-version"
		}
	]
}
