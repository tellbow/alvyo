# Copy to .env next to compose.prod.yaml and fill in.

# Public host name; Caddy obtains a Let's Encrypt certificate for it.
DOMAIN=alvyo.example.ch
# Image tag / git SHA shown on the About page.
VERSION=dev

POSTGRES_PASSWORD=change-me

# Outgoing mail (verification, password reset).
SMTP_HOST=smtp.example.ch
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=starttls
MAIL_FROM="Alvyo <noreply@alvyo.example.ch>"

# Shown on the About page as the operator contact.
CONTACT_EMAIL=
# Operator on the about page (data protection law): name and postal address
# on one line, e.g. OPERATOR_ADDRESS="Weg 1, 3000 Bern".
OPERATOR_NAME=
OPERATOR_ADDRESS=
